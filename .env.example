# Environemt to run in. Options [production, development]
ENVIRONMENT=development
#The application host name
HOST=localhost
#The application port to get access from the docker container
PORT=7789

#Parameters for getting the access to the db
DB_USER=local_user
DB_PASSWORD=password
DB_DRIVER=mysql
DB_NAME=lorekeeper
DB_HOST=lorekeeper_mysql
DB_PORT=3307

#The application and the db will be accessible from the host machine on these ports
TEST_DB_HOST=0.0.0.0
EXPOSE_PORT=7788
EXPOSE_DB_PORT=56743
TEST_EXPOSE_DB_PORT=56744

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Admin seed user
ADMIN_USERNAME=JBrokenshire
ADMIN_PASSWORD=password